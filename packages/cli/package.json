{
  "name": "stackai",
  "version": "0.1.11",
  "description": "StackAI — AI coding agent in your terminal. Read, write, and edit code with AI.",
  "type": "module",
  "bin": {
    "stackai": "./dist/cli.js"
  },
  "files": ["dist"],
  "keywords": [
    "ai",
    "cli",
    "coding-agent",
    "agent",
    "mimo",
    "code-generation",
    "developer-tools"
  ],
  "homepage": "https://usestackai.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stackaiagent/Usestackai.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Stackaiagent/Usestackai/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsup",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.77.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@stackai/core": "workspace:*",
    "@types/react": "^18.3.18",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
