{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_KEY",
    "SUPABASE_ANON_KEY",
    "MIMO_API_KEY",
    "MIMO_BASE_URL",
    "UPSTASH_REDIS_URL",
    "UPSTASH_REDIS_TOKEN",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "TWITTER_CLIENT_ID",
    "TWITTER_CLIENT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
