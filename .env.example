# Single deployment — the API is folded into the Next.js app.
# Copy to apps/web/.env.local and fill in. (Do NOT commit the real file.)

# Auth (NextAuth + X OAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Xiaomi MiMo (AI provider)
MIMO_API_KEY=
# MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1   # optional override

# Upstash Redis (rate limiting) — optional locally (falls back to in-memory)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
